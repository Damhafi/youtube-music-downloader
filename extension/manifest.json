{
    "manifest_version": 3,
    "name": "YouTube Music Downloader",
    "description": "Baixe músicas e playlists do YouTube como MP3 320kbps com um clique",
    "version": "1.1.0",
    "permissions": [
        "activeTab",
        "tabs",
        "scripting",
        "notifications"
    ],
    "host_permissions": [
        "http://127.0.0.1:5000/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "*://www.youtube.com/*",
                "*://music.youtube.com/*",
                "*://youtu.be/*"
            ],
            "js": ["content.js"],
            "css": ["content.css"]
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
